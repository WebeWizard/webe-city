{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City declared districts, version 1",
  "description": "Districts declare repository-relative scope only; they grant no execution authority. Runtime validation additionally checks unique IDs and normalized paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "districts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "districts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "not": { "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]" }
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))\\S(?:[^\\r\\n]*\\S)?$",
            "not": { "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]" }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "not": { "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]" }
          }
        }
      }
    }
  }
}
