{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City work orders, versions 1 and 2",
  "description": "Intake, proposal and delivery lifecycle. Version 1 records remain valid without project association; version 2 records require projectIds. Runtime validation also enforces initial received history, the transition graph (blocked may resume in-progress only while authorization is current), monotonic timestamps, final-state consistency, local city identity, append-only CLI writes, and that every history entry into authorized or completed matches exactly one schemaVersion 2 decision with the same timestamp. authorized and completed are entered only via the authorize and complete commands. Provenance is self-reported, not human authorization; records from plugin 0.1.0 remain valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "cityId",
    "title",
    "request",
    "acceptanceCriteria",
    "status",
    "createdAt",
    "updatedAt",
    "history",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "id": {
      "type": "string",
      "pattern": "^WO-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "$ref": "#/$defs/text",
      "maxLength": 500
    },
    "request": {
      "$ref": "#/$defs/text",
      "maxLength": 20000
    },
    "acceptanceCriteria": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text",
        "maxLength": 2000
      }
    },
    "projectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "status": {
      "enum": [
        "received",
        "triaged",
        "proposed",
        "awaiting-approval",
        "authorized",
        "in-progress",
        "inspection",
        "awaiting-merge",
        "completed",
        "blocked",
        "rejected",
        "withdrawn",
        "reopened"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason",
          "timestamp"
        ],
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/properties/status"
              }
            ]
          },
          "to": {
            "$ref": "#/properties/status"
          },
          "reason": {
            "$ref": "#/$defs/text",
            "maxLength": 4000
          },
          "timestamp": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "plugin"
      ],
      "properties": {
        "source": {
          "const": "local-draft"
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "repository-city"
            },
            "version": {
              "enum": [
                "0.1.0",
                "0.2.0",
                "0.3.0"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": { "required": ["projectIds"] }
    },
    {
      "if": {
        "properties": {
          "history": {
            "contains": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "to": {
                  "const": "proposed"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "acceptanceCriteria": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
