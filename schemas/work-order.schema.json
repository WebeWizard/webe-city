{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City work orders, versions 1 and 2",
  "description": "Intake, proposal and delivery lifecycle. Version 1 remains valid without projects; version 2 requires projectIds. Optional development metadata is additive in either version; no migration is required. Runtime additionally validates lifecycle continuity and linked decisions, registered scope, sequential append-only development revisions, exact screening/application references, chronology and ready-packet completeness. Development timestamps do not change lifecycle updatedAt. Current adopted policy enables readiness gates for subsequent authorization, not retroactive invalidation of earlier delivery. Professional sources and evidence are unauthenticated, not semantic policy verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "cityId",
    "title",
    "request",
    "acceptanceCriteria",
    "status",
    "createdAt",
    "updatedAt",
    "history",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "id": {
      "type": "string",
      "pattern": "^WO-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "$ref": "#/$defs/text",
      "maxLength": 500
    },
    "request": {
      "$ref": "#/$defs/text",
      "maxLength": 20000
    },
    "acceptanceCriteria": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text",
        "maxLength": 2000
      }
    },
    "projectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "development": { "$ref": "#/$defs/development" },
    "status": {
      "enum": [
        "received",
        "triaged",
        "proposed",
        "awaiting-approval",
        "authorized",
        "in-progress",
        "inspection",
        "awaiting-merge",
        "completed",
        "blocked",
        "rejected",
        "withdrawn",
        "reopened"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason",
          "timestamp"
        ],
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/properties/status"
              }
            ]
          },
          "to": {
            "$ref": "#/properties/status"
          },
          "reason": {
            "$ref": "#/$defs/text",
            "maxLength": 4000
          },
          "timestamp": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "plugin"
      ],
      "properties": {
        "source": {
          "const": "local-draft"
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "repository-city"
            },
            "version": {
              "enum": [
                "0.1.0",
                "0.2.0",
                "0.3.0"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": { "required": ["projectIds"] }
    },
    {
      "if": {
        "properties": {
          "history": {
            "contains": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "to": {
                  "const": "proposed"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "acceptanceCriteria": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenings", "applications", "assessments"],
      "properties": {
        "screenings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/screening" } },
        "applications": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/application" } },
        "assessments": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/assessment" } }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "evidenceText": { "$ref": "#/$defs/text", "maxLength": 4000 },
    "safeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "projectScope": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "questions": {
      "type": "array", "maxItems": 50, "uniqueItems": true,
      "items": { "$ref": "#/$defs/text", "maxLength": 2000 }
    },
    "screening": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "recordedAt", "sourceOffice", "authenticated", "provenance", "snapshot", "route", "projectIds", "scopeEvidence", "reason", "evidence", "impacts", "questions", "policyCitations", "requirements"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "sourceOffice": { "const": "chief-planner" },
        "authenticated": { "const": false },
        "provenance": { "$ref": "#/properties/provenance" },
        "snapshot": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "route": { "enum": ["lightweight", "formal", "needs-clarification"] },
        "projectIds": { "$ref": "#/$defs/projectScope" },
        "scopeEvidence": { "$ref": "#/$defs/evidenceText" },
        "reason": { "$ref": "#/$defs/evidenceText" },
        "evidence": { "$ref": "#/$defs/evidenceText" },
        "impacts": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": { "enum": ["new-project", "substantial-capability", "architecture", "ownership-boundary", "public-interface", "data-migration", "security", "operations", "cost", "cross-project"] }
        },
        "questions": { "$ref": "#/$defs/questions" },
        "policyCitations": {
          "type": "array", "maxItems": 50,
          "contains": {
            "type": "object", "required": ["path", "projectIds"],
            "properties": { "path": { "const": "policies/development-applications.md" }, "projectIds": { "type": "array", "maxItems": 0 } }
          },
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "section", "projectIds"],
            "properties": {
              "path": { "type": "string", "pattern": "^policies/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.md$" },
              "section": { "$ref": "#/$defs/text", "maxLength": 2000 },
              "projectIds": { "$ref": "#/$defs/projectScope" }
            }
          }
        },
        "requirements": {
          "type": "array", "maxItems": 25,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "kind": { "enum": ["proposal", "diagram", "specification", "project-facts", "study"] },
              "description": { "$ref": "#/$defs/text", "maxLength": 2000 },
              "reason": { "$ref": "#/$defs/text", "maxLength": 2000 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "route": { "const": "lightweight" } } },
          "then": { "properties": { "impacts": { "maxItems": 0 }, "questions": { "maxItems": 0 }, "requirements": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "route": { "const": "needs-clarification" } } },
          "then": { "properties": { "questions": { "minItems": 1 } } },
          "else": { "properties": { "projectIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "route": { "const": "formal" } } },
          "then": { "properties": { "requirements": { "minItems": 1 } } }
        }
      ]
    },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "recordedAt", "sourceOffice", "authenticated", "provenance", "screeningRevision", "reason", "evidence", "proposal", "answers", "artifacts"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "sourceOffice": { "const": "development-advisor" },
        "authenticated": { "const": false },
        "provenance": { "$ref": "#/properties/provenance" },
        "screeningRevision": { "$ref": "#/$defs/revision" },
        "reason": { "$ref": "#/$defs/evidenceText" },
        "evidence": { "$ref": "#/$defs/evidenceText" },
        "proposal": { "$ref": "#/$defs/text", "maxLength": 20000 },
        "answers": {
          "type": "array", "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["question", "answer"],
            "properties": { "question": { "$ref": "#/$defs/text", "maxLength": 2000 }, "answer": { "$ref": "#/$defs/evidenceText" } }
          }
        },
        "artifacts": {
          "type": "array", "maxItems": 25,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["requirementId", "disposition", "evidence"],
            "properties": {
              "requirementId": { "$ref": "#/$defs/text", "maxLength": 64 },
              "disposition": { "enum": ["provided", "not-applicable"] },
              "evidence": { "$ref": "#/$defs/evidenceText" }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "recordedAt", "sourceOffice", "authenticated", "provenance", "applicationRevision", "outcome", "reason", "evidence"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "sourceOffice": { "const": "chief-planner" },
        "authenticated": { "const": false },
        "provenance": { "$ref": "#/properties/provenance" },
        "applicationRevision": { "$ref": "#/$defs/revision" },
        "outcome": { "enum": ["ready", "revise"] },
        "reason": { "$ref": "#/$defs/evidenceText" },
        "evidence": { "$ref": "#/$defs/evidenceText" }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
