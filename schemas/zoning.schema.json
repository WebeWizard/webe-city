{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City zoning map, version 1",
  "description": "Path-based change rules for repository scope. Zoning is separate from project delivery scope and district ownership, and grants no authority to deliver.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "zones"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "description", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": { "$ref": "#/$defs/text", "maxLength": 200 },
          "path": {
            "anyOf": [
              { "const": "." },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)(?:\\.city|\\.git)(?:/|$))\\S(?:[^\\r\\n]*\\S)?$"
              }
            ]
          },
          "description": { "$ref": "#/$defs/text", "maxLength": 2000 },
          "rules": {
            "type": "array",
            "maxItems": 11,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["changeType", "disposition", "requirements"],
              "properties": {
                "changeType": {
                  "enum": ["documentation", "tests", "bugfix", "refactor", "feature", "public-interface", "dependency", "data-migration", "security", "deletion", "generated-code"]
                },
                "disposition": { "enum": ["permitted", "conditional", "prohibited"] },
                "requirements": {
                  "type": "array",
                  "maxItems": 25,
                  "items": { "$ref": "#/$defs/text", "maxLength": 2000 }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "disposition": { "const": "conditional" } } },
                  "then": { "properties": { "requirements": { "minItems": 1 } } },
                  "else": { "properties": { "requirements": { "maxItems": 0 } } }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": { "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]" }
    }
  }
}
