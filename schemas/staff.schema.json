{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City engineering staff, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "cityId", "title", "agentName", "skillName", "requisitionId",
    "status", "tools", "checks", "mcpProposals", "files", "hiredAt", "updatedAt", "history",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "not": { "const": "municipal-software-engineer" } },
    "cityId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "title": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 &+./-]{0,59}$" },
    "agentName": { "type": "string" },
    "skillName": { "type": "string", "pattern": "^city-engineering-[a-z][a-z0-9-]{1,40}$" },
    "requisitionId": { "type": "string", "pattern": "^REQ-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "status": { "enum": ["active", "retired"] },
    "tools": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["read", "search", "edit", "execute"] },
      "allOf": [
        { "contains": { "const": "read" }, "minContains": 1 },
        { "contains": { "const": "search" }, "minContains": 1 }
      ]
    },
    "checks": { "$ref": "requisition.schema.json#/$defs/checks" },
    "mcpProposals": { "type": "array", "maxItems": 10, "items": { "$ref": "requisition.schema.json#/$defs/line500" } },
    "files": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^\\.github/(agents/city-engineer-[a-z][a-z0-9-]{1,40}\\.agent\\.md|skills/city-engineering-[a-z][a-z0-9-]{1,40}/(SKILL\\.md|references/practice\\.md|scripts/(run-checks\\.mjs|checks\\.json)))$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "hiredAt": { "$ref": "requisition.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "requisition.schema.json#/$defs/timestamp" },
    "history": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "actor", "reason", "timestamp"],
        "properties": {
          "from": { "type": ["null", "string"], "enum": [null, "active"] },
          "to": { "enum": ["active", "retired"] },
          "actor": { "const": "human-resources" },
          "reason": { "$ref": "requisition.schema.json#/$defs/text", "maxLength": 4000 },
          "timestamp": { "$ref": "requisition.schema.json#/$defs/timestamp" }
        }
      }
    },
    "provenance": { "$ref": "requisition.schema.json#/$defs/provenance" }
  }
}
