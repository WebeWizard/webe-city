{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City institutional review",
  "description": "A bounded record of review observations and recommendations. It does not adopt policy, appoint offices, authorize delivery, or authenticate the actor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "cityId",
    "conductedBy",
    "summary",
    "windowStart",
    "coversThrough",
    "triggers",
    "recommendations",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^IR-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "cityId": { "type": "string", "format": "uuid" },
    "conductedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "windowStart": { "type": "string", "format": "date-time" },
    "coversThrough": { "type": "string", "format": "date-time" },
    "triggers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observed", "threshold", "due"],
        "properties": {
          "name": {
            "enum": [
              "periodic-volume",
              "periodic-time",
              "returned-or-rejected",
              "inspection-failures",
              "referrals",
              "blocked"
            ]
          },
          "observed": { "type": "integer", "minimum": 0 },
          "threshold": { "type": "integer", "minimum": 1 },
          "due": { "type": "boolean" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rationale", "precedent", "sources", "route", "reservedMatters"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "precedent": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "route": { "enum": ["administrative", "council", "resident"] },
          "reservedMatters": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["governance", "security", "deletion", "deployment", "publication", "expenditure"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "reservedMatters": { "minItems": 1 } }, "required": ["reservedMatters"] },
            "then": { "properties": { "route": { "const": "resident" } } }
          }
        ]
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "plugin"],
      "properties": {
        "source": { "const": "local-draft" },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "repository-city" },
            "version": { "type": "string" }
          }
        }
      }
    }
  }
}
