{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository City draft configuration, version 1 (legacy)",
  "description": "Legacy draft configuration. Still accepted read-only so existing cities remain valid; upgrade explicitly with the migrate command, which preserves all city records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugin",
    "cityId",
    "name",
    "createdAt",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "repository-city"
        },
        "version": {
          "enum": ["0.1.0", "0.2.0", "0.3.0"]
        }
      }
    },
    "cityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "governance": {
      "const": "draft"
    }
  }
}
